# 复制本文件为 .env 并填入你的配置（.env 请勿提交到版本库）
# 未配置 LLM_API_KEY 时，服务自动进入演示模式

# 大模型密钥（必填，留空则进入演示模式）
LLM_API_KEY=

# 兼容 OpenAI 协议的接口地址（可选，默认 https://api.openai.com/v1）
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称（可选，默认 gpt-4o-mini）
LLM_MODEL=gpt-4o-mini

# 请求超时时间，单位毫秒（可选，默认 30000）
LLM_TIMEOUT_MS=30000

# 服务监听端口（可选，默认 3000）
PORT=3000
