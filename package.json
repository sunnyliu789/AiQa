{
  "name": "ai-qa",
  "version": "1.0.0",
  "description": "AI 答疑助手：检索课程资料后调用大模型作答（原生 Node.js 实现，零第三方依赖）",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:api": "vitest run tests/ask.integration.test.js",
    "test:e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "qa",
    "rag",
    "nodejs"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
